generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum ConnectionType {
  SAMPLE
  INTERPOLATION
  COVER
  REMIX
}

model Song {
  id        String   @id @default(cuid())
  title     String
  artist    String
  year      Int?
  genre     String?
  coverUrl  String?
  spotifyId String?
  youtubeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sampledBy Connection[] @relation("SourceSong")
  samples   Connection[] @relation("DerivativeSong")

  @@index([title])
  @@index([artist])
}

model Connection {
  id          String         @id @default(cuid())
  type        ConnectionType
  description String?

  timestampSource     Int?
  timestampDerivative Int?

  sourceSongId String
  sourceSong   Song   @relation("SourceSong", fields: [sourceSongId], references: [id], onDelete: Cascade)

  derivativeSongId String
  derivativeSong   Song   @relation("DerivativeSong", fields: [derivativeSongId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceSongId, derivativeSongId, type])
  @@index([sourceSongId])
  @@index([derivativeSongId])
}
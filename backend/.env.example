# Copia este archivo como .env y ajusta los valores.

# Conexión que usa la aplicación (con pooling, si tu base lo ofrece)
DATABASE_URL="postgresql://postgres:songdna@localhost:5432/songdna"

# Conexión directa, que usan las migraciones de Prisma
DIRECT_URL="postgresql://postgres:songdna@localhost:5432/songdna"

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000
